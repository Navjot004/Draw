# ==========================================
# Mystery Name Shuffle - Environment Config
# ==========================================

# Security
SECRET_KEY=change-to-a-cryptographically-secure-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database Configuration
# For Local Zero-Setup (Default SQLite):
DATABASE_URL=sqlite:///./mystery_draw.db

# For Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password@localhost:5432/mystery_draw_db

# Google Sheets API Integration (Optional - Falls back to Demo Mode with 6,000+ realistic records if omitted)
GOOGLE_SHEET_ID=your_google_spreadsheet_id_from_url
GOOGLE_SHEET_RANGE=Form Responses 1!A:Z
# Path to downloaded Google Service Account JSON key:
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# Or inline JSON string (useful for cloud platforms like Render, Railway, or Heroku):
# GOOGLE_SERVICE_ACCOUNT_INFO={"type": "service_account", "project_id": "...", ...}

# Demo Mode Settings
DEMO_STUDENTS_COUNT=6250
FORCE_DEMO_MODE=false

# CORS Allowed Origins
# Comma-separated or array
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
